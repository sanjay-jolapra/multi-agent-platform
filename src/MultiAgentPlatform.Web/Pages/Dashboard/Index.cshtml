@page
@model MultiAgentPlatform.Web.Pages.Dashboard.IndexModel
@using MultiAgentPlatform.Domain.Enums
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card metric-card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold">@Model.Metrics.TotalApplications</div>
                <div class="text-muted small">Total apps</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold text-success">@Model.Metrics.RunningApplications</div>
                <div class="text-muted small">Running</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold text-secondary">@Model.Metrics.StoppedApplications</div>
                <div class="text-muted small">Stopped</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold">@Model.Metrics.AgentExecutionsTotal</div>
                <div class="text-muted small">Agent executions</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold">@Model.Metrics.AverageAgentExecutionMs.ToString("0.#")<span class="fs-6"> ms</span></div>
                <div class="text-muted small">Avg execution</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold text-danger">@Model.Metrics.ConnectorFailuresLast24h</div>
                <div class="text-muted small">Connector fails (24h)</div>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <span class="badge bg-success me-1">Healthy @Model.Metrics.Healthy</span>
    <span class="badge bg-warning text-dark me-1">Degraded @Model.Metrics.Degraded</span>
    <span class="badge bg-danger me-1">Unhealthy @Model.Metrics.Unhealthy</span>
    <span class="badge bg-dark me-1">Offline @Model.Metrics.Offline</span>
    <span class="badge bg-secondary me-1">Unknown @Model.Metrics.Unknown</span>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-2">
        <input type="text" name="UserId" value="@Model.Filter.UserId" class="form-control" placeholder="User Id" />
    </div>
    <div class="col-md-2">
        <input type="text" name="ApplicationId" value="@Model.Filter.ApplicationId" class="form-control" placeholder="Application Id" />
    </div>
    <div class="col-md-2">
        <select name="HealthState" class="form-select">
            <option value="">Any health</option>
            @foreach (var h in Enum.GetValues<HealthState>())
            {
                <option value="@h" selected="@(Model.Filter.HealthState == h)">@h</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="text" name="AgentDefinitionId" value="@Model.Filter.AgentDefinitionId" class="form-control" placeholder="Agent Id" />
    </div>
    <div class="col-md-2">
        <input type="text" name="ConnectorDefinitionId" value="@Model.Filter.ConnectorDefinitionId" class="form-control" placeholder="Connector Id" />
    </div>
    <div class="col-md-1">
        <input type="date" name="From" class="form-control" />
    </div>
    <div class="col-md-1">
        <input type="date" name="To" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary btn-sm">Apply filters</button>
        <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary btn-sm">Reset</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Owner</th>
                <th>Status</th>
                <th>Health</th>
                <th>Version</th>
                <th>Last heartbeat</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model.Applications)
            {
                <tr>
                    <td>@app.Name</td>
                    <td>@app.OwnerUserId</td>
                    <td><span class="badge bg-info text-dark">@app.Status</span></td>
                    <td><span class="badge bg-secondary">@app.HealthState</span></td>
                    <td>@app.Version</td>
                    <td>@(app.LastHeartbeatAt?.ToString("u") ?? "never")</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-page="/Applications/Details" asp-route-id="@app.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
