@page
@model MultiAgentPlatform.Web.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "Chat";
}
<div class="row" data-conversation-id="@Model.ConversationId">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Application wizard</span>
                <span class="text-muted small">Conversation @Model.ConversationId</span>
            </div>
            <div class="card-body d-flex flex-column">
                <div id="messages" class="chat-messages flex-grow-1 mb-3"></div>
                <div class="input-group">
                    <input type="text" id="chatInput" class="form-control" placeholder="Type your answer..." />
                    <button type="button" id="chatSend" class="btn btn-primary">Send</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Live preview</span>
                <span class="badge bg-warning text-dark">PREVIEW &mdash; not yet deployed</span>
            </div>
            <div class="card-body">
                <div id="preview-root" class="text-muted">
                    Nothing generated yet. Answer the wizard's questions and confirm to generate an application.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        window.__chatHistory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.History.Select(m => new { sender = m.SenderType.ToString().ToLowerInvariant(), content = m.Content })));
    </script>
    <script src="~/js/schemaRenderer.js"></script>
    <script src="~/js/chat.js"></script>
}
